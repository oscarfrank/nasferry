# Optional. The web wizard stores folders and dest passwords on the NAS.
# Use this file only if you want a dashboard login or to pre-set options.

# Optional dashboard login. Blank = anyone on the LAN can open the page.
DASHBOARD_USER=
DASHBOARD_PASS=

# Start copying as soon as the process starts (resumes by size).
AUTO_START=false

# Concurrent file copies / comparisons. 4/8 is gentle on HDD NAS boxes.
TRANSFERS=4
CHECKERS=8

# Extra rclone exclude rules, comma-separated. CacheClip is already skipped.
EXTRA_EXCLUDES=

# Skip TrueNAS app folders (ix-applications, ix-apps, .system).
EXCLUDE_SYSTEM=true
