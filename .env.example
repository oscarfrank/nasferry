# Copy-server talks to rclone over localhost. File data never
# touches the machine that opened the webpage — only the NAS
# running this container should copy files.

# Bind this TrueNAS dataset (or pool root) into the container as /source.
# Example: /mnt/tank
SOURCE_HOST_PATH=/mnt/zeus

# local = read from /source inside the container (recommended on TrueNAS)
# smb   = pull from the other NAS over the network (use this if the
#         container runs on the TerraMaster instead)
SOURCE_KIND=local
SOURCE_PATH=/source

# If SOURCE_KIND=smb (TrueNAS share):
SOURCE_SMB_HOST=
SOURCE_SMB_SHARE=zeus
SOURCE_SMB_PATH=
SOURCE_SMB_USER=
SOURCE_SMB_PASS=
SOURCE_SMB_DOMAIN=WORKGROUP

# SMB share name (required). PATH is a folder inside that share.
# Leave PATH empty to copy into the share root.
DEST_KIND=smb
DEST_SMB_HOST=
DEST_SMB_SHARE=zeus
DEST_SMB_PATH=
DEST_SMB_USER=
DEST_SMB_PASS=
DEST_SMB_DOMAIN=WORKGROUP

# If DEST_KIND=local (container running on TerraMaster):
DEST_PATH=/dest

# Concurrent file copies / comparisons. 4/8 is gentle on HDD NAS boxes.
TRANSFERS=4
CHECKERS=8

# Start copying as soon as the container is up (resumes by size).
AUTO_START=false

# Optional dashboard login. Leave blank for open LAN access.
DASHBOARD_USER=
DASHBOARD_PASS=

# Extra rclone exclude rules, comma-separated.
EXTRA_EXCLUDES=

# Skip TrueNAS app/system datasets (ix-applications, ix-apps, .system).
EXCLUDE_SYSTEM=true
